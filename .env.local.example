OPENAI_API_KEY=여기에_OpenAI_API_키를_입력하세요

# 푸시 알림 (FCM) — Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# private_key 값(여러 줄 PEM)은 .env 파서가 줄바꿈/따옴표를 깨뜨리기 쉬우므로
# base64로 인코딩해서 FIREBASE_PRIVATE_KEY_B64 에 넣는 걸 권장:
#   node -e "console.log(Buffer.from(require('./serviceAccountKey.json').private_key).toString('base64'))"
FIREBASE_PRIVATE_KEY_B64=
# 위 대신 원본 PEM을 그대로 쓰고 싶다면 (배포 환경에 따라 줄바꿈이 안전하게 유지되는 경우):
FIREBASE_PRIVATE_KEY=

# 채팅 실시간 브로드캐스트 (Supabase Realtime) — 브라우저에 노출되는 값이라 anon(public) key만 사용한다.
# Supabase 대시보드 > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=