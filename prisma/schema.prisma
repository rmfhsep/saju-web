generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int     @id @default(autoincrement())
  phone            String  @unique
  passwordHash     String
  name             String?
  gender           String?
  calendarType     String?
  birthDate        String?
  birthTime        String?
  birthTimeUnknown Boolean @default(false)

  termsAgreed     Boolean @default(false)
  marketingAgreed Boolean @default(false)
  signupComplete  Boolean @default(false)

  sajuResult String?

  nickname        String?
  location        String?
  job             String?
  jobDetail       String?
  height          Int?
  smoking         String?
  drinking        String?
  datingPurpose   String?
  politics        String?
  religion        String?
  income          String?
  photos          String?
  bioTags         String?
  bio             String?
  recommendedTags String?

  blockedPhones   String?
  blockedCount    Int     @default(0)
  profileComplete Boolean @default(false)

  preferredFilterType String?
  preferredHeightMin  Int?
  preferredHeightMax  Int?
  preferredSmoking    String?
  preferredDrinking   String?
  preferredPolitics   String?
  preferredReligion   String?
  filterComplete      Boolean @default(false)

  // 알림 설정
  serviceNotify    Boolean  @default(true)   // 서비스(혜택/이벤트) 알림 수신
  pushEnabled      Boolean  @default(false)  // 기기 푸시 권한 허용 여부 (추후 네이티브가 갱신)
  pushToken        String?                   // 네이티브 앱이 등록한 푸시 디바이스 토큰 (FCM/APNs 등)

  // 별(포인트) 잔액 — 스토어 구매 등으로 지급, 유효기간 없음
  stars Int @default(0)

  // 온보딩 미니게임 지급 별 (7일 만료) — lib/stars.ts 참고
  trialStars         Int       @default(0)
  trialStarsExpireAt DateTime?
  miniGamePlayed     Boolean   @default(false)

  // 추천(오늘의 추천) 24시간 배치 마지막 확인 시각 — 매번 새로 계산하지 않고 이걸로 24h 경과 여부만 체크
  lastRecoCheckAt DateTime?

  // 매칭 풀(prompt/maju_matching_pool_spec.1.1.1.md) 관련 필드
  lastLoginAt        DateTime? // GET /api/auth/me 호출 시마다 갱신 — activityScore(§4-1) 산출용
  grade              String?   // "gold" | "silver" | "newbie" — 주간 배치(app/api/cron/weekly-grade)가 갱신, 비공개(§5)
  gradeScore         Float?    // grade 산출에 쓰인 원점수(§5-2), 디버깅/운영용
  preferenceFilters  String?   // JSON string[] — 활성화된 필터 타입("height"|"smoking"|"drinking"|"politics"|"religion", §3)

  // 매일 출석 별 적립 마지막 지급 시각 — 24시간 지났으면 추천 탭 진입 시 별 1개 자동 적립
  // TODO(심사 완료 후 제거): 결제 심사 대비 임시 기능. app/api/daily-checkin 및 관련 UI와 함께 정리할 것
  lastStarCheckInAt DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 매칭 풀 조회(lib/pool/hardFilter.ts)가 gender+profileComplete(+location startsWith)로
  // 매번 필터링하는데 인덱스가 없어 풀 테이블 스캔이 나던 것을 방지.
  @@index([gender, profileComplete, location])
}

// 실제 유저와 섞인 더미(시드) 유저의 User.id 마커 — User row 자체와는 별도 테이블로 표시만 한다.
model DummyUser {
  userId    Int      @id
  createdAt DateTime @default(now())
}

// 탈퇴 회원 재가입 제한 — 탈퇴일로부터 30일간 동일 번호 재가입 불가
model WithdrawnPhone {
  phone       String   @id
  withdrawnAt DateTime @default(now())
}

// 탈퇴 사유 로그 — WithdrawnPhone(재가입 제한, phone당 1행)과 달리 append-only로 매 탈퇴마다 남긴다.
model WithdrawReason {
  id        Int      @id @default(autoincrement())
  phone     String
  reason    String // 탈퇴 사유 선택지 원문 (예: "좋은 인연을 만났어요")
  detail    String? // "기타" 선택 시 직접입력 텍스트
  createdAt DateTime @default(now())
}

// 호감(좋아요) — 별 1개 소모, 같은 상대에게 중복 전송 불가
model Like {
  id         Int      @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

// 궁합 잠금해제 — 별 1개 소모, 같은 상대 궁합은 한 번만 차감(재방문 시 그대로 노출)
model CompatUnlock {
  id           Int      @id @default(autoincrement())
  userId       Int
  targetUserId Int
  createdAt    DateTime @default(now())

  @@unique([userId, targetUserId])
}

// 메시지 — 두 유저 사이 첫 메시지는 별 3개 소모, 이후 답장은 무료
model Message {
  id         Int       @id @default(autoincrement())
  fromUserId Int
  toUserId   Int
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([fromUserId, toUserId])
  @@index([toUserId, fromUserId])
}

// PayApp 결제 요청/완료/취소 내역 — mulNo는 PayApp이 발급하는 결제요청번호 (lib/payapp.ts 참고)
model Payment {
  id           Int       @id @default(autoincrement())
  userId       Int
  mulNo        String    @unique
  goodname     String
  price        Int
  state        Int       @default(1) // 1=요청, 4=결제완료, 8/32=요청취소, 9/64=승인취소
  payDate      DateTime?
  payurl       String?
  qrurl        String?
  var1         String?
  var2         String?
  cancelMemo   String?
  // feedbackurl은 여러 번 재호출될 수 있어(PayApp 정책), 결제완료 콜백 한 번당 별을 한 번만 지급하기 위한 플래그
  starsGranted Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
}

// 별 충전/사용 내역 — 스토어 결제(충전), 좋아요/메시지 소모(사용) 등 모든 별 증감을 기록
model StarTransaction {
  id           Int      @id @default(autoincrement())
  userId       Int
  type         String // "charge" | "spend"
  amount       Int // 충전: 양수, 사용: 음수
  reason       String // "스토어 충전" | "좋아요 보내기" | "쪽지 보내기" 등
  balanceAfter Int // 처리 후 잔여 별 수(stars + 유효 trialStars 합산)
  mulNo        String? // 충전인 경우 PayApp 결제요청번호(Payment.mulNo)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

// 유저별 추천(오늘의 추천) 이력 — 누적 저장, 같은 상대 중복 추천 방지에도 사용
model Recommendation {
  id            Int      @id @default(autoincrement())
  userId        Int
  recommendedId Int
  createdAt     DateTime @default(now())

  @@unique([userId, recommendedId])
  @@index([userId])
}

// iOS 심사용 백도어 로그인 계정 — 앱스토어 심사관이 전화번호 인증 없이 로그인할 수 있도록 별도 관리.
// userId는 심사 전용으로 만든 데모 User를 가리키며, 실제 유저 계정과는 분리되어 있다.
model ReviewAccount {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  userId       Int
  createdAt    DateTime @default(now())
}

// 프로필 신고 — 신고 자체는 매칭/열람을 막지 않고 운영진 검토용으로만 쌓인다.
model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reportedId Int
  reason     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([reportedId])
  @@index([reporterId])
}

// 유저 차단 — 단방향 기록이지만 조회 시 항상 양방향으로 확인해 서로의 프로필/추천에서 제외한다.
model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
