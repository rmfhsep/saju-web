generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int      @id @default(autoincrement())
  phone            String   @unique
  passwordHash     String
  name             String?
  gender           String?
  calendarType     String?
  birthDate        String?
  birthTime        String?
  birthTimeUnknown Boolean  @default(false)

  termsAgreed      Boolean  @default(false)
  marketingAgreed  Boolean  @default(false)
  signupComplete   Boolean  @default(false)

  sajuResult       String?

  nickname         String?
  location         String?
  job              String?
  jobDetail        String?
  height           Int?
  smoking          String?
  drinking         String?
  datingPurpose    String?
  politics         String?
  religion         String?
  income           String?
  photos           String?
  bioTags          String?
  bio              String?
  recommendedTags  String?

  blockedPhones    String?
  blockedCount     Int      @default(0)
  profileComplete  Boolean  @default(false)

  preferredFilterType String?
  preferredHeightMin  Int?
  preferredHeightMax  Int?
  preferredSmoking    String?
  preferredDrinking   String?
  preferredPolitics   String?
  preferredReligion   String?
  filterComplete      Boolean  @default(false)

  // 알림 설정
  serviceNotify    Boolean  @default(true)   // 서비스(혜택/이벤트) 알림 수신
  pushEnabled      Boolean  @default(false)  // 기기 푸시 권한 허용 여부 (추후 네이티브가 갱신)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
